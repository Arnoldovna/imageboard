# Rendered by the nginx image at container start (envsubst) into /etc/nginx/conf.d/default.conf, which nginx
# includes inside the http {} block. Only API_MAX_BODY_SIZE, CSP_IMG_SRC_EXTRA and TRUSTED_PROXY_CIDR are substituted
# (defaults in the Dockerfile, NGINX_ENVSUBST_FILTER); everything else written with a dollar sign is an nginx variable.
#
# An add_header inside a location drops all server-level add_header lines, so caching and the security headers are
# decided by maps and every header is set once at server level. An empty value sends no header.
map $uri $cache_control {
  ~^/assets/  "public, max-age=31536000, immutable";
  ~^/api/     "";
  default     "no-cache";
}

# nginx adds each security header only when the response does not carry its own. The API (helmet) sets all four on
# every response it sends (HSTS too, over https), so /api/ never gets a second, conflicting copy (B-10). Everything
# else gets nginx's: the SPA and its assets, and every response nginx generates itself, also under /api/ (413 for an
# oversized body, 502/504 while the API is down, the /api/health 404). Map values are evaluated when add_header runs,
# after the upstream response headers have arrived.
map $upstream_http_content_security_policy $csp_header {
  ""       "default-src 'self'; img-src 'self' data: blob: ${CSP_IMG_SRC_EXTRA}; style-src 'self'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'";
  default  "";
}

map $upstream_http_x_frame_options $frame_options_header {
  ""       "DENY";
  default  "";
}

map $upstream_http_x_content_type_options $nosniff_header {
  ""       "nosniff";
  default  "";
}

map $upstream_http_referrer_policy $referrer_policy_header {
  ""       "strict-origin-when-cross-origin";
  default  "";
}

# HSTS (F-42) only when the user's connection was https, i.e. the trusted load balancer said so ($fwd_proto below),
# with the API's HSTS_POLICY (security.test.ts keeps the two equal), and only when the response has none of its own
# (the API sends it when cookies are Secure and X-Forwarded-Proto is https). Plain http never gets it from nginx or
# the API, so the local stack cannot pin 127.0.0.1.
map "$fwd_proto:$upstream_http_strict_transport_security" $hsts_header {
  "https:"  "max-age=31536000; includeSubDomains";
  default   "";
}

# Keep the scheme a TLS-terminating load balancer reports (ADR 0019), but only when the request really comes from
# that load balancer (TRUSTED_PROXY_CIDR) and names http or https. Anyone else gets nginx's own scheme, so a client
# talking to nginx directly cannot claim https over plain http (the API trusts this header through TRUST_PROXY).
geo $from_trusted_proxy {
  default 0;
  ${TRUSTED_PROXY_CIDR} 1;
}

map "$from_trusted_proxy:$http_x_forwarded_proto" $fwd_proto {
  ~^1:(?<lb_proto>https?)$ $lb_proto;
  default $scheme;
}

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  server_tokens off;

  # Without `always`: only 2xx/3xx responses get Cache-Control, so a 404 for a missing hashed asset (a stale
  # index.html during a deploy) is never cached as immutable for a year.
  add_header Cache-Control $cache_control;
  add_header X-Content-Type-Options $nosniff_header always;
  add_header Referrer-Policy $referrer_policy_header always;
  add_header X-Frame-Options $frame_options_header always;
  add_header Content-Security-Policy $csp_header always;
  add_header Strict-Transport-Security $hsts_header always;

  # Compression settings for the static locations below, which switch gzip on; /api/ leaves it off.
  gzip_vary on;
  gzip_min_length 1024;
  gzip_types text/css application/javascript image/svg+xml;

  # Health is internal: the compose healthcheck and load balancers probe the api container directly (ADR 0013).
  # Case-insensitive regex (it wins over the /api/ prefix): /api/HEALTH must not slip through to the API. nginx has
  # decoded percent-escapes and merged slashes before it matches.
  location ~* ^/api/health(?:/|$) {
    return 404;
  }

  # No gzip here: compressing responses that mix secrets and attacker input invites BREACH.
  location /api/ {
    proxy_pass http://api:3000;
    # The client's Host header as sent, port included: the API's fetch-metadata guard compares Origin
    # (`http://127.0.0.1:8080`) with `<scheme>://<Host>` when APP_ORIGIN is unset, and `$host` drops the port.
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $fwd_proto;
    proxy_set_header X-Request-Id $request_id;
    client_max_body_size ${API_MAX_BODY_SIZE};
  }

  location /assets/ {
    gzip on;
    try_files $uri =404;
  }

  # SPA history fallback: every non-file path serves index.html; the router renders its own 404 page.
  location / {
    gzip on;
    try_files $uri $uri/ /index.html;
  }
}
