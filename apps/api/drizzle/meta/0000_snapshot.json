      "checkConstraints": {
        "images_object_key_format": {
          "name": "images_object_key_format",
          "value": "\"images\".\"object_key\" ~ '^images/[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.(jpg|png|webp|gif)$'"
        },
        "images_mime_type_allowed": {
          "name": "images_mime_type_allowed",
          "value": "\"images\".\"mime_type\" IN ('image/jpeg', 'image/png', 'image/webp', 'image/gif')"
        },
        "images_object_key_matches_mime": {
          "name": "images_object_key_matches_mime",
          "value": "substring(\"images\".\"object_key\" from '\\.([a-z]+)$') = CASE \"images\".\"mime_type\" WHEN 'image/jpeg' THEN 'jpg' WHEN 'image/png' THEN 'png' WHEN 'image/webp' THEN 'webp' WHEN 'image/gif' THEN 'gif' END"
        },
        "images_dimensions_positive": {
          "name": "images_dimensions_positive",
          "value": "\"images\".\"width\" > 0 AND \"images\".\"height\" > 0"
        },
        "images_size_positive": {
          "name": "images_size_positive",
          "value": "\"images\".\"size_bytes\" > 0"
        },
        "images_author_name_valid": {
          "name": "images_author_name_valid",
          "value": "char_length(\"images\".\"author_name\") BETWEEN 1 AND 60 AND \"images\".\"author_name\" !~ '^[\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]|[\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]$' AND \"images\".\"author_name\" !~ '[\\u0001-\\u001F\\u007F-\\u009F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]'"
        },
        "images_title_valid": {
