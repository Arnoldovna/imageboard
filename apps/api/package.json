{
  "name": "@app/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "pnpm --filter @app/shared build && drizzle-kit generate",
    "db:migrate": "tsx --conditions=development --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "SEED_ALLOW=true tsx --conditions=development --env-file-if-exists=../../.env src/scripts/seed-cli.ts",
    "db:seed:check": "tsx --conditions=development --env-file-if-exists=../../.env src/scripts/seed-cli.ts --check",
    "seed:fetch-images": "tsx --conditions=development --env-file-if-exists=../../.env src/scripts/fetch-seed-images.ts",
    "admin:remove-image": "tsx --conditions=development --env-file-if-exists=../../.env src/scripts/admin-remove-image.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "@aws-sdk/client-s3": "3.1169.0",
    "connect-redis": "10.0.0",
    "cookie-parser": "1.4.7",
    "csrf-csrf": "4.1.0",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "express-session": "1.19.0",
    "file-type": "22.3.0",
    "helmet": "8.3.0",
    "multer": "2.5.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "rate-limit-redis": "6.0.2",
    "redis": "6.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15"
  }
}
