# Local development configuration. `pnpm setup:env` copies this file to .env (or adds missing keys to an existing
# .env) and fills every empty *SECRET* key with a random value. It never overwrites a value. Never commit .env.
# Every value here is a throwaway for the local Docker stack. Commented-out keys are optional.

# --- API (apps/api/src/config/env.ts validates all of these) -------------------------------------------------
# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# API listen port (Vite proxies /api to it in `pnpm dev`)
PORT=3000
# Number of reverse proxies in front of the API: 0 for `pnpm dev`; compose sets 1 (nginx)
TRUST_PROXY=0
# Secure + __Host- cookies; defaults to true in production. Plain http locally, so false.
COOKIE_SECURE=false
# Origin accepted by the fetch-metadata guard; unset = the request's own origin (ADR 0003)
# APP_ORIGIN=https://imageboard.example
# On SIGTERM: ms between failing readiness (503) and closing the listener (0..60000). 0 locally; behind a load
# balancer at least its health-probe interval x unhealthy threshold, so it stops routing before connections close
SHUTDOWN_DELAY_MS=0

# --- Postgres (compose service and the API's connection string) -----------------------------------------------
# Compose creates the database from these three (on the first start of the volume) and builds the containers' URL
# from them, so use URL-safe characters only.
POSTGRES_USER=imageboard
POSTGRES_PASSWORD=local-only
POSTGRES_DB=imageboard
# Used by `pnpm dev` and `pnpm db:migrate` on the host. Must name the same user, password and database as the three
# keys above; `pnpm dev:setup` stops with a message when they disagree.
DATABASE_URL=postgres://imageboard:local-only@127.0.0.1:5432/imageboard

# --- Redis: sessions and rate limits --------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
# Separate Redis for rate-limit counters in production (ADR 0002); unset = REDIS_URL
# RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6380

# --- Sessions and CSRF (secrets: generated by pnpm setup:env, at least 32 characters) -------------------------
SESSION_SECRET=
# Cookie max-age / Redis TTL of sessions that have posted, in days (1..400)
SESSION_MAX_AGE_DAYS=180
# Cookie max-age / Redis TTL of sessions that never posted, in hours (1..168)
SESSION_PROVISIONAL_HOURS=24
CSRF_SECRET=

# --- Object storage (MinIO locally, S3 in production) ---------------------------------------------------------
# Unset for AWS S3
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=eu-central-1
S3_BUCKET=imageboard
# MinIO root user; the secret below is its root password (generated by pnpm setup:env)
S3_ACCESS_KEY_ID=minio-local
S3_SECRET_ACCESS_KEY=
# MinIO needs path-style URLs
S3_FORCE_PATH_STYLE=true
# Base for image URLs in API responses (a path, or an absolute CDN URL later)
MEDIA_PUBLIC_BASE_URL=/api/media

# --- Uploads and pagination -----------------------------------------------------------------------------------
# Max upload size in bytes (<= 20 MiB); keep API_MAX_BODY_SIZE (below) slightly above it
UPLOAD_MAX_BYTES=5242880
# Max pixels per frame (decompression bombs)
UPLOAD_MAX_PIXELS=40000000
# Max frames of an animated GIF/WebP (1..1000)
UPLOAD_MAX_FRAMES=200
# Longest edge of stored images in px (512..8192)
IMAGE_MAX_EDGE=2560
# Default page sizes (1..50)
IMAGES_PAGE_SIZE=12
COMMENTS_PAGE_SIZE=20

# --- Rate limits per window (ADR 0013; windows are fixed in code) ---------------------------------------------
# Every /api request per IP, per 5 min
RATE_LIMIT_GLOBAL=300
# New anonymous identities per IP, per hour
RATE_LIMIT_IDENTITIES=20
# Uploads per IP, per hour
RATE_LIMIT_UPLOADS=10
# Uploads from all clients together, per day
RATE_LIMIT_UPLOADS_GLOBAL_DAY=200
# Comments per IP, per 10 min
RATE_LIMIT_COMMENTS=20
# Deletes (images and comments) per IP, per 10 min
RATE_LIMIT_DELETES=30
# Media requests per IP, per 5 min
RATE_LIMIT_MEDIA=1200

# --- Compose only ---------------------------------------------------------------------------------------------
# nginx body limit for /api in the web container (nginx size syntax). Raise it together with UPLOAD_MAX_BYTES, so the
# API, not nginx, answers 413 (ADR 0013)
API_MAX_BODY_SIZE=6m
# Host port of `pnpm stack:up` / `pnpm demo` (http://127.0.0.1:8080)
WEB_PORT=8080
# Host port of the isolated e2e project imageboard-e2e (pnpm test:e2e, pnpm e2e:up)
E2E_PORT=8181
